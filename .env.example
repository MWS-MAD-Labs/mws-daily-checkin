# ─────────────────────────────────────────────────────────
# mws-daily-checkin — Environment Variables Template
# Copy to .env and fill in actual values
# In Komodo: define these in Stack → Environment Variables
# ─────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3001

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-with: openssl rand -hex 64>
JWT_EXPIRES_IN=15m

# Hub-only Central entitlement authorization
HUB_BASE_URL=https://hub.example.org
CENTRAL_ORGANIZATION_ID=<central-organization-id-from-the-application-setup>
# Seconds between asking Central who may use the app (minimum 15, 0 turns the sync off)
DAILY_AUTO_SYNC_SECONDS=60

# Central roster/profile lookup used after Hub identity verification
MWS_DATA_CENTER_API_URL=https://db.example.org/api/internal
MWS_DATA_CENTER_API_TOKEN=<central-service-token>

# Google OAuth
GOOGLE_CLIENT_ID=<from-google-cloud-console>
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>
GOOGLE_REDIRECT_URL=https://checkin-stg.mws.web.id/auth/google/callback
SESSION_SECRET=<generate-with: openssl rand -hex 32>

# Google AI (for face scan emotion analysis)
GOOGLE_AI_API_KEY=<from-google-ai-studio>
GOOGLE_AI_MODEL=gemini-flash-latest
GOOGLE_AI_FALLBACK_MODEL=gemini-1.5-flash
AI_ANALYSIS_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Frontend URL (used for OAuth callback, Slack deep-links)
FRONTEND_URL=https://checkin-stg.mws.web.id

# CORS — allowed origins
CORS_ORIGINS=https://checkin-stg.mws.web.id

# Slack (optional, for check-in notifications)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=<from-slack-app-settings>

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@millennia21.id
SMTP_PASS=<app-password>
SMTP_FROM=no-reply@millennia21.id

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=600

# Presence verification and shared site weather
# Enable the required flags only after the production coordinates are verified.
CHECKIN_STAFF_LOCATION_REQUIRED=false
CHECKIN_STUDENT_SESSION_REQUIRED=false
CHECKIN_SITE_ID=main-field
CHECKIN_SITE_NAME=Main Field
CHECKIN_SITE_LATITUDE=
CHECKIN_SITE_LONGITUDE=
CHECKIN_SITE_RADIUS_METERS=75
CHECKIN_MAX_ACCURACY_METERS=35
CHECKIN_EDGE_TOLERANCE_METERS=10
CHECKIN_LOCATION_MAX_AGE_SECONDS=45
CHECKIN_LOCATION_POLICY_VERSION=field-radius-v1
CHECKIN_SITE_TIMEZONE=Asia/Jakarta
CHECKIN_STUDENT_SESSION_MINUTES=15
CHECKIN_WEATHER_ENABLED=true
CHECKIN_WEATHER_CACHE_MINUTES=15
