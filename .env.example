# ─────────────────────────────────────────────────────────
# mws-daily-checkin — Environment Variables Template
# Copy to .env and fill in actual values
# In Komodo: define these in Stack → Environment Variables
# ─────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3001

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-with: openssl rand -hex 64>
JWT_EXPIRES_IN=7d

# Hub SSO relay verification. Copy the public key that matches Hub's
# HUB_SSO_PRIVATE_KEY; do not configure Hub's private key here.
HUB_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Google OAuth
GOOGLE_CLIENT_ID=<from-google-cloud-console>
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>
GOOGLE_REDIRECT_URL=https://checkin-stg.mws.web.id/auth/google/callback
SESSION_SECRET=<generate-with: openssl rand -hex 32>

# Google AI (for face scan emotion analysis)
GOOGLE_AI_API_KEY=<from-google-ai-studio>
GOOGLE_AI_MODEL=gemini-flash-latest
GOOGLE_AI_FALLBACK_MODEL=gemini-1.5-flash
AI_ANALYSIS_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Frontend URL (used for OAuth callback, Slack deep-links)
FRONTEND_URL=https://checkin-stg.mws.web.id

# CORS — allowed origins
CORS_ORIGINS=https://checkin-stg.mws.web.id

# Slack (optional, for check-in notifications)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=<from-slack-app-settings>

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@millennia21.id
SMTP_PASS=<app-password>
SMTP_FROM=no-reply@millennia21.id

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=600
