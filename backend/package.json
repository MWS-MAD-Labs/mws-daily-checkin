{
  "name": "mws-daily-checkin-backend",
  "version": "1.0.0",
  "description": "Backend API for MWS Daily Emotional Check-In",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:smoke": "jest tests/smoke --runInBand",
    "test:watch": "jest --watch",
    "seed": "node src/scripts/seedUsersFromData.js",
    "sync:users:latest": "node src/scripts/syncLatestUserRoster.js --apply",
    "sync:users:latest:dry": "node src/scripts/syncLatestUserRoster.js"
  },
  "keywords": [
    "emotional-wellness",
    "daily-checkin",
    "mws",
    "express",
    "mongodb"
