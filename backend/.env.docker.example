AI_ANALYSIS_ENABLED=true
AI_DISABLED_MESSAGE=AI emotional analysis is temporarily unavailable. Please use the Manual Check-in option.
CACHE_TTL=3600
CHECKIN_RATE_LIMIT_MAX_REQUESTS=400
CHECKIN_RATE_LIMIT_WINDOW=1
# Vite's `base` defaults to '/daily-checkin/' (matching MTSS's own '/mtss/'
# convention - see frontend/vite.config.js), so this needs the prefix baked
# in, e.g. https://your-domain.com/daily-checkin.
FRONTEND_URL=http://localhost:5173
# Comma-separated explicit allowlist. Required in production.
CORS_ORIGINS=http://localhost:5173
GOOGLE_AI_API_KEY=CHANGE_ME
GOOGLE_AI_FALLBACK_MODEL=gemini-1.5-flash
GOOGLE_AI_MODEL=gemini-flash-latest
GOOGLE_AI_VISION_FALLBACK_MODEL=gemini-1.5-flash-8b
GOOGLE_AI_VISION_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MIN_DELAY_MS=600
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=IntegraLearn AI Chat
JWT_EXPIRES_IN=1d
JWT_SECRET=CHANGE_ME
# Shared with MTSS's AI_CHAT_PROXY_SECRET - must match exactly.
AI_CHAT_PROXY_SECRET=CHANGE_ME
# MTSS backend, for the server-to-server AI-chat proxy.
MTSS_API_BASE_URL=https://app.millenniaws.sch.id/mtss/api/v1
LOG_LEVEL=info
MONGODB_URI=CHANGE_ME
NODE_ENV=development
PORT=3003
HUB_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_WINDOW=15
SESSION_CACHE_TTL=86400
SLACK_APP_TOKEN=CHANGE_ME
SLACK_BOT_TOKEN=CHANGE_ME
SLACK_SIGNING_SECRET=CHANGE_ME
SMTP_FROM=no-reply@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=CHANGE_ME
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.com
